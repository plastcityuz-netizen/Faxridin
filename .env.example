# Public canonical site URL. Set this to your real HTTPS domain before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Never prefix these with NEXT_PUBLIC_ and never commit real values.
# Create a bot with @BotFather. The bot must be able to message the destination.
TELEGRAM_BOT_TOKEN=
# Numeric chat/group ID, or @channelusername for a channel where the bot is an admin.
# A public contact username is not necessarily a valid bot destination chat ID.
TELEGRAM_CHAT_ID=

# When both Telegram values are absent, the UI offers an explicit copy-and-send
# fallback to https://t.me/penaplast_uz. It never claims an order was delivered.
